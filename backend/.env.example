# ── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Origens autorizadas a chamar a API (separadas por vírgula). Vazio = só a mesma origem.
# Ex.: https://seu-usuario.github.io
CORS_ORIGINS=

# ── Segurança ────────────────────────────────────────────
# Troque por um texto longo e aleatório em produção (ex.: openssl rand -hex 32)
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=12h
# Permite que novas pessoas criem conta pela tela de login (true/false)
ALLOW_SIGNUP=true
ORG_NAME=Autec

# ── Banco de dados e arquivos ────────────────────────────
DATABASE_FILE=./data/autec.db
STORAGE_DIR=./data/files
MAX_UPLOAD_MB=25

# ── Inteligência artificial (Anthropic / Claude) ─────────
# A chave fica SOMENTE no servidor. Crie em https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
